# Imagen de PRODUCCIÓN del frontend web para Railway.
#
# Contexto de build = RAÍZ del repositorio (Railway: Root Directory = "/" y
# Dockerfile Path = deploy/Dockerfile.web). El frontend importa
# ../../../shared/metros desde fe/src/utils/metros.ts, así que el contexto
# NUNCA puede fijarse en fe/: un build con contexto fe/ falla porque Rollup
# no puede resolver shared/ fuera del contexto. Aquí se replica el layout
# del repositorio (/app/fe + /app/shared) para que tsc y Vite resuelvan
# exactamente igual que en desarrollo y CI.

FROM node:22-alpine AS build

# COREPACK_HOME compartido: corepack enable/prepare corren como root y su
# caché quedaría en /root; el build (usuario root) sí la ve, pero se
# conserva el patrón probado de fe/Dockerfile por si algún paso hereda
# permisos distintos. Con ENV compartido y legible, corepack usa el mismo
# pnpm@11.4.0 del build, sin red.
ENV COREPACK_HOME=/usr/local/share/corepack
RUN corepack enable && corepack prepare pnpm@11.4.0 --activate \
 && chmod -R a+rX "$COREPACK_HOME"

ENV CI=true

WORKDIR /app

# pnpm-workspace.yaml es parte de la instalación: contiene 'allowBuilds'
# (aprobación de scripts de build, p. ej. esbuild). Sin copiarlo, pnpm 11
# aborta en CI con ERR_PNPM_IGNORED_BUILDS.
COPY fe/package.json fe/pnpm-lock.yaml fe/pnpm-workspace.yaml ./fe/
# --frozen-lockfile (S8544): instala estrictamente lo resuelto en
# pnpm-lock.yaml; nunca re-resuelve versiones nuevas en el build.
RUN cd fe && pnpm install --frozen-lockfile

# Copia el resto del proyecto en el MISMO layout que el repositorio. El
# .dockerignore de la raíz excluye node_modules/dist/.env para no
# sobreescribir la instalación ni filtrar secretos.
COPY fe/ ./fe/
COPY shared/ ./shared/

# Variables VITE horneadas en el bundle en tiempo de build:
# - VITE_API_URL=/api/v1: la web llama al API por el MISMO origen y nginx
#   hace el proxy (/api/v1/ → BACKEND_PROXY_URL). Sin CORS ni dominios
#   duplicados.
# - VITE_GOOGLE_CLIENT_ID: Client ID OAuth público (viaja en el bundle).
#   Vacío → fallback público definido en fe/src/utils/google.ts. NUNCA es
#   un secreto y no debe pasarse ningún secret como build arg.
ARG VITE_GOOGLE_CLIENT_ID=""
ENV VITE_API_URL=/api/v1 \
    VITE_GOOGLE_CLIENT_ID=${VITE_GOOGLE_CLIENT_ID}

RUN cd fe && pnpm run build

FROM nginx:1.27-alpine

COPY --from=build /app/fe/dist/ /usr/share/nginx/html/
# Configuración COMPLETA de nginx (main) horneada con el valor por defecto
# del proxy: la usa el CMD local. En Railway el startCommand re-renderiza la
# plantilla con el BACKEND_PROXY_URL real a /tmp y arranca con `nginx -c`,
# porque Railway NO permite escribir /etc/nginx/conf.d en runtime (lo monta
# read-only y aplica su propia config genérica de nginx: causa raíz del 404
# del healthcheck con la via conf.d).
COPY deploy/templates/nginx-main.template /etc/nginx/templates/nginx-main.template
# envsubst SOLO con la lista de la variable del proxy: sin lista, reemplazaría
# también $uri/$host/$scheme (variables de nginx) y rompería try_files.
# ARG con default: el valor de Railway llega en runtime vía startCommand.
ARG BACKEND_PROXY_URL=http://127.0.0.1:8000
RUN envsubst '$BACKEND_PROXY_URL' < /etc/nginx/templates/nginx-main.template > /etc/nginx/nginx-web.conf

# El default.conf stock NO se usa (la config -c no incluye conf.d); se
# elimina y se dejan los directorios de estado para el usuario nginx.
RUN rm -f /etc/nginx/conf.d/default.conf \
 && touch /var/run/nginx.pid \
 && mkdir -p /tmp/client_body /tmp/proxy /tmp/fastcgi /tmp/uwsgi /tmp/scgi \
 && chown -R nginx:nginx /var/cache/nginx /etc/nginx/conf.d /var/run/nginx.pid /tmp/client_body /tmp/proxy /tmp/fastcgi /tmp/uwsgi /tmp/scgi
USER nginx

EXPOSE 80

# CMD local: config horneada (proxy por defecto 127.0.0.1). Railway usa el
# startCommand (re-render a /tmp con el BACKEND_PROXY_URL real).
CMD ["nginx", "-c", "/etc/nginx/nginx-web.conf", "-g", "daemon off;"]

# Railway hace el healthcheck HTTP contra el puerto expuesto; /healthz es
# un endpoint estático del propio nginx (no depende del backend).
