MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
SECRET_KEY=
MINIO_PASSWORD=

# Rate limiting (slowapi)
RATE_LIMIT_ENABLED=true
# Con varios workers/procesos usa un backend compartido (p. ej. redis://...).
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_HEADERS_ENABLED=true
# IPs/CIDR del reverse proxy autorizado a enviar X-Forwarded-For.
# "*" solo si la API no es accesible directamente.
TRUSTED_PROXIES=172.16.0.0/12
