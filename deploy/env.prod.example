# Plantilla del despliegue de producción. Copiar a deploy/.env.prod y chmod 600.
# Generar cada contraseña alfanumérica con: openssl rand -hex 32
# No reutilizar valores entre cuentas ni subir deploy/.env.prod a Git.

# === MySQL (el esquema productivo de este proyecto se llama neodomus) ===
MYSQL_ROOT_PASSWORD=CHANGE_ME_IN_PROD
MYSQL_APP_USER=neodomus_app_runtime
MYSQL_APP_PASSWORD=CHANGE_ME_IN_PROD
MYSQL_OWNER_USER=neodomus_migrator
MYSQL_OWNER_PASSWORD=CHANGE_ME_IN_PROD
MYSQL_BACKUP_USER=neodomus_backup_runtime
MYSQL_BACKUP_PASSWORD=CHANGE_ME_IN_PROD

# === API / JWT ===
SECRET_KEY=CHANGE_ME_IN_PROD
MIGRATION_JOB_SECRET=CHANGE_ME_IN_PROD
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
ENVIRONMENT=production
LOG_LEVEL=INFO
FRONTEND_URL=https://neodomus.example
CORS_ORIGINS=https://neodomus.example
FRONTEND_VERIFY_EMAIL_PATH=/verify-email
FRONTEND_RESET_PASSWORD_PATH=/reset-password

# === Rate limiting y proxy ===
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_HEADERS_ENABLED=true
TRUSTED_PROXIES=172.16.0.0/12

# === MinIO ===
MINIO_USER=neodomus_storage
MINIO_PASSWORD=CHANGE_ME_IN_PROD
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=https://neodomus.example
MINIO_BUCKET=neodomus-media
MINIO_PRIVATE_BUCKET=neodomus-private
# La API habla HTTP por la red interna privada de Compose; TLS termina en el proxy público.
MINIO_SECURE=false

# === Correo ===
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME_IN_PROD
SMTP_PASSWORD=CHANGE_ME_IN_PROD
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SIGNIN_CLIENT_ID=
RESEND_API_KEY=
RESEND_FROM_EMAIL=Neodomus <onboarding@example.com>
VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=10

# === Funciones ===
PAYMENT_PROVIDER=simulator
NOTIFICAR_CLIENTE_CAMBIOS_TECNICO=false
